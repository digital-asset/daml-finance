source_env_if_exists .envrc.private

# Keep TMPDIR usable when shells inherit stale nix-shell temp paths.
ensure_tmpdir() {
	if [ -z "${TMPDIR:-}" ] || [ ! -d "$TMPDIR" ] || [ ! -w "$TMPDIR" ]; then
		export TMPDIR=/var/tmp
	fi
}

ensure_tmpdir

use nix

# `use nix` can overwrite TMPDIR; re-validate after nix env activation.
ensure_tmpdir

watch_file daml.yaml
PATH_add bin

# --- DPM configuration ---
export REPO_ROOT=$(pwd)
export DPM_REGISTRY="europe-docker.pkg.dev/da-images/public-all"
export DPM_HOME="${REPO_ROOT}/.dpm/"
export DPM_SDK_VERSION="3.4.9"