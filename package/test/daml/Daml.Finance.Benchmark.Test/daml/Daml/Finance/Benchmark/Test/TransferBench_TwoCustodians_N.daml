module Daml.Finance.Benchmark.Test.TransferBench_TwoCustodians_N where

import Daml.Script
import DA.Map qualified as Map (fromList)
import DA.Set qualified as Set (fromList)
import DA.Text qualified as Text (trim, parseDecimal)

import Daml.Finance.Interface.Types.Common.V3.Types
  ( AccountKey(..)
  , HoldingFactoryKey(..)
  , HoldingStandard(..)
  , Id(..)
  , InstrumentKey(..)
  , PartiesMap(..)
  )

import Daml.Finance.Interface.Account.V4.Factory qualified as AccountFactory (I)
import Daml.Finance.Interface.Holding.V4.Factory qualified as HoldingFactory (I, Reference(..), View(..))
import Splice.Api.Token.HoldingV1 qualified as Api.HoldingV1 (Holding)
import Daml.Finance.Interface.Instrument.Token.V4.Factory qualified as TokenFactory (Create(..), I)
import Daml.Finance.Interface.Instrument.Token.V4.Types (Token(..))

import Daml.Finance.Account.V4.Account qualified as Account (Factory(..))
import Daml.Finance.Holding.V4.Factory qualified as Holding (Factory(..))
import Daml.Finance.Instrument.Token.V4.Factory qualified as Token (Factory(..))

import Daml.Finance.Benchmark.Test.Workflow.CreateAccount qualified as CreateAccount (Accept(..), Request(..))
import Daml.Finance.Benchmark.Test.Workflow.CreditAccount qualified as CreditAccount (Accept(..), Request(..))
import Daml.Finance.Benchmark.Test.Workflow.Transfer qualified as Transfer (Accept(..), Request(..))

--------------------------------------------------------------------------------
-- Persisted setup state

template TransferTwoCustodiansSetup
  with
    aliceBank : Party
    bobBank : Party
    alice : Party
    bob : Party
    suffix : Text

    accountFactoryCid : ContractId AccountFactory.I

    -- separate holding factories per custodian
    holdingFactoryKeyAliceBank : HoldingFactoryKey
    holdingFactoryKeyBobBank   : HoldingFactoryKey

    tokenFactoryCidAliceBank : ContractId TokenFactory.I

    aliceAccount : AccountKey
    bobAccount   : AccountKey
    cashInstrument : InstrumentKey

    aliceCashHoldingCid : ContractId Api.HoldingV1.Holding
  where
    signatory aliceBank
    observer bobBank, alice, bob

    key (aliceBank, suffix) : (Party, Text)
    maintainer key._1

--------------------------------------------------------------------------------
-- Helpers
debugCommon : Party -> Party -> Party -> Party -> Text -> Text -> Script ()
debugCommon alice aliceBank bob bobBank suffix extra = do
  debug $ "ALICE_ID=" <> show alice
  debug $ "ALICE_BANK_ID=" <> show aliceBank
  debug $ "BOB_ID=" <> show bob
  debug $ "BOB_BANK_ID=" <> show bobBank
  debug $ "SUFFIX=" <> show suffix
  debug $ "EXTRA=" <> show extra

parseParty : Text -> Script Party
parseParty t =
  case partyFromText (Text.trim t) of
    Some p -> pure p
    None -> abort ("Bad party id: " <> t)

parseDecimalText : Text -> Script Decimal
parseDecimalText t =
  case Text.parseDecimal (Text.trim t) of
    Some d -> pure d
    None -> abort ("Bad decimal: " <> t)

lookupSetup
  : Party
  -> Text
  -> Script (ContractId TransferTwoCustodiansSetup, TransferTwoCustodiansSetup)
lookupSetup aliceBank suffix = do
  m <- queryContractKey @TransferTwoCustodiansSetup aliceBank (aliceBank, suffix)
  case m of
    None ->
      abort $
        "TransferTwoCustodiansSetup not found for key (aliceBank, suffix)=("
          <> show aliceBank <> ", " <> show suffix <> "). Did you run runSetup?"
    Some (cid, st) -> pure (cid, st)

mkObservers : [Party] -> PartiesMap
mkObservers ps =
  if null ps then mempty
  else Map.fromList [("Observers", Set.fromList ps)]

--------------------------------------------------------------------------------
-- Setup (run once / not measured)
-- Args: (ALICE_ID, ALICE_BANK_ID, BOB_ID, BOB_BANK_ID, suffix)

runSetup : (Text, Text, Text, Text, Text) -> Script ()
runSetup (aliceText, aliceBankText, bobText, bobBankText, suffix) = script do
  alice <- parseParty aliceText
  aliceBank <- parseParty aliceBankText
  bob <- parseParty bobText
  bobBank <- parseParty bobBankText

  debugCommon alice aliceBank bob bobBank suffix "setup"

  -- Account Factory (owned by AliceBank, but usable by both custodians here)
  accountFactoryCid <- toInterfaceContractId @AccountFactory.I <$> submit aliceBank do
    createCmd Account.Factory with
      provider = aliceBank
      observers = mkObservers [alice, bob, bobBank]

  -- Holding factories: one per custodian
  let holdingFactoryIdA = Id ("HoldingFactoryA@" <> suffix)
  holdingFactoryCidA : ContractId HoldingFactory.I <-
    toInterfaceContractId @HoldingFactory.I <$> submit aliceBank do
      createCmd Holding.Factory with
        provider = aliceBank
        id = holdingFactoryIdA
        observers = mkObservers [alice, bob, bobBank]

  submit aliceBank do
    createCmd HoldingFactory.Reference with
      factoryView = HoldingFactory.View with
        provider = aliceBank
        id = holdingFactoryIdA
      cid = holdingFactoryCidA
      observers = mkObservers [alice, bob, bobBank]

  let holdingFactoryKeyA = HoldingFactoryKey with
        provider = aliceBank
        id = holdingFactoryIdA

  let holdingFactoryIdB = Id ("HoldingFactoryB@" <> suffix)
  holdingFactoryCidB : ContractId HoldingFactory.I <-
    toInterfaceContractId @HoldingFactory.I <$> submit bobBank do
      createCmd Holding.Factory with
        provider = bobBank
        id = holdingFactoryIdB
        observers = mkObservers [alice, bob, aliceBank]

  submit bobBank do
    createCmd HoldingFactory.Reference with
      factoryView = HoldingFactory.View with
        provider = bobBank
        id = holdingFactoryIdB
      cid = holdingFactoryCidB
      observers = mkObservers [alice, bob, aliceBank]

  let holdingFactoryKeyB = HoldingFactoryKey with
        provider = bobBank
        id = holdingFactoryIdB

  -- Token factory + instrument minted by AliceBank
  tokenFactoryCidAliceBank <- toInterfaceContractId @TokenFactory.I <$> submit aliceBank do
    createCmd Token.Factory with
      provider = aliceBank
      observers = mempty

  let instrumentKey = InstrumentKey with
        issuer = aliceBank
        depository = aliceBank
        id = Id ("USD@" <> suffix)
        version = "0"
        holdingStandard = TransferableFungible

  now <- getTime
  submit aliceBank do
    exerciseCmd tokenFactoryCidAliceBank TokenFactory.Create with
      token = Token with
        instrument = instrumentKey
        description = "USD token (two-custodian benchmark)"
        validAsOf = now
      observers = mempty

  -- Create Alice account at AliceBank
  aliceReqCid <- submit alice do
    createCmd CreateAccount.Request with
      owner = alice
      custodian = aliceBank

  aliceAccount <- submit aliceBank do
    exerciseCmd aliceReqCid CreateAccount.Accept with
      label = "Alice@AliceBank"
      description = "Alice account at AliceBank"
      accountFactoryCid
      holdingFactory = holdingFactoryKeyA
      observers = [bob, bobBank]
      controllers = None

  -- Create Bob account at BobBank
  bobReqCid <- submit bob do
    createCmd CreateAccount.Request with
      owner = bob
      custodian = bobBank

  bobAccount <- submit bobBank do
    exerciseCmd bobReqCid CreateAccount.Accept with
      label = "Bob@BobBank"
      description = "Bob account at BobBank"
      accountFactoryCid
      holdingFactory = holdingFactoryKeyB
      observers = [alice, aliceBank]
      controllers = None

  
  -- Credit Alice with a cash holding at AliceBank (2 tx, setup only)
  aliceCreditReqCid <- submit alice do
    createCmd CreditAccount.Request with
      account = aliceAccount
      instrument = instrumentKey
      amount = 1000.0

  aliceCashHoldingCid <- submit aliceBank do
    exerciseCmd aliceCreditReqCid CreditAccount.Accept

  -- Persist setup
  submit aliceBank do
    createCmd TransferTwoCustodiansSetup with
      aliceBank
      bobBank
      alice
      bob
      suffix
      accountFactoryCid
      holdingFactoryKeyAliceBank = holdingFactoryKeyA
      holdingFactoryKeyBobBank = holdingFactoryKeyB
      tokenFactoryCidAliceBank
      aliceAccount
      bobAccount
      cashInstrument = instrumentKey
      aliceCashHoldingCid

  debug "Setup done"
  pure ()

--------------------------------------------------------------------------------
-- Measured: TRANSFER REQUEST (1 tx) + ACCEPT (1 tx)
-- Args: (ALICE_BANK_ID, suffix, amountText)
--
-- Tx1: Bob creates Transfer.Request (visible to Bob + Alice; banks may see via observers/underlying holding)
-- Tx2: Alice accepts and triggers Transferable.Transfer to Bob's account (cross-custodian)

runTransferRequestAccept : (Text, Text, Text) -> Script ()
runTransferRequestAccept (aliceBankText, suffix, amountText) = script do
  aliceBank <- parseParty aliceBankText
  (_, setup) <- lookupSetup aliceBank suffix
  amount <- parseDecimalText amountText

  debugCommon setup.alice setup.aliceBank setup.bob setup.bobBank suffix ("transfer-request amount=" <> show amount)

  transferRequestCid <- submit setup.bob do
    createCmd Transfer.Request with
      receiverAccount = setup.bobAccount
      instrument = setup.cashInstrument
      amount = amount
      currentOwner = setup.alice

  _bobCashHoldingCid <- submit setup.alice do
    exerciseCmd transferRequestCid Transfer.Accept with
      holdingCid = setup.aliceCashHoldingCid

  debug "Transfer.Request + Transfer.Accept done (two custodians)"
  pure ()
