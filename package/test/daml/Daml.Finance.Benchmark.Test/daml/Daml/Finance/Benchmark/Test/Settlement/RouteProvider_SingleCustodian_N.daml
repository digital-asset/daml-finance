module Daml.Finance.Benchmark.Test.Settlement.RouteProvider_SingleCustodian_N where

import Daml.Script
import DA.Set (fromList)
import DA.Text qualified as Text

import Daml.Finance.Interface.Settlement.V4.RouteProvider qualified as RouteProvider (Discover(..), I)
import Daml.Finance.Interface.Settlement.V4.Types qualified as ST (Quantity(..), RoutedStep, Step(..))

import Daml.Finance.Interface.Types.Common.V3.Types()
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Daml.Finance.Settlement.V4.RouteProvider.SingleCustodian (SingleCustodian(..))

--------------------------------------------------------------------------------
-- Helpers 

parseParty : Text -> Script Party
parseParty t =
  case partyFromText (Text.trim t) of
    Some p -> pure p
    None -> abort ("Bad party id: " <> show t)

parseNat : Text -> Script Int
parseNat t =
  case Text.parseInt (Text.trim t) of
    Some n | n >= 0 -> pure n
    _ -> abort ("Bad non-negative int: " <> show t)

parseDecimalOrAbort : Text -> Script Decimal
parseDecimalOrAbort t =
  case Text.parseDecimal (Text.trim t) of
    Some d -> pure d
    None -> abort ("Bad decimal: " <> show t)

mkInstrumentId : Party -> Text -> InstrumentId
mkInstrumentId admin unitText =
  InstrumentId with
    admin = admin
    id = Text.trim unitText

mkStep : Party -> Party -> InstrumentId -> Decimal -> ST.Step
mkStep alice bob unit amount =
  ST.Step with
    sender = alice
    receiver = bob
    quantity = ST.Quantity with
      amount = amount
      unit = unit

--------------------------------------------------------------------------------
-- Stored benchmark state split into:
--   - Params (created once, not measured)
--   - RouteProviderState (created by measured create step)

template RouteDiscoveryParams
  with
    provider : Party
    alice : Party
    bob : Party
    custodian : Party
    unit : InstrumentId
    suffix : Text
  where
    signatory provider
    observer alice, bob
    key (provider, suffix) : (Party, Text)
    maintainer key._1

template RouteProviderState
  with
    provider : Party
    suffix : Text
    routeProviderCid : ContractId RouteProvider.I
  where
    signatory provider
    key (provider, suffix) : (Party, Text)
    maintainer key._1

lookupParams : Party -> Text -> Script RouteDiscoveryParams
lookupParams provider suffix = do
  m <- queryContractKey @RouteDiscoveryParams provider (provider, suffix)
  case m of
    None ->
      abort $
        "RouteDiscoveryParams not found for (provider,suffix)=("
          <> show provider <> ", " <> show suffix <> "). Did you run runInitRouteDiscovery?"
    Some (_cid, st) -> pure st

lookupRouteProvider : Party -> Text -> Script RouteProviderState
lookupRouteProvider provider suffix = do
  m <- queryContractKey @RouteProviderState provider (provider, suffix)
  case m of
    None ->
      abort $
        "RouteProviderState not found for (provider,suffix)=("
          <> show provider <> ", " <> show suffix <> "). Did you run runCreateRouteProvider?"
    Some (_cid, st) -> pure st

--------------------------------------------------------------------------------
-- Setup (run once / not measured)
-- Args: (provider, alice, bob, custodian, unitIdText, suffix)
-- Stores only params, no RouteProvider created.

runSetup : (Text, Text, Text, Text, Text, Text) -> Script ()
runSetup (providerText, aliceText, bobText, custodianText, unitText, suffix) = script do
  provider  <- parseParty providerText
  alice <- parseParty aliceText
  bob <- parseParty bobText
  custodian <- parseParty custodianText
  let unit = mkInstrumentId custodian unitText

  submit provider do
    createCmd RouteDiscoveryParams with
      provider
      alice
      bob
      custodian
      unit
      suffix

  debug "Init done (no RouteProvider created)"
  pure ()

--------------------------------------------------------------------------------
-- Measured: CREATE RouteProvider (1 tx)
-- Args: (provider, suffix)
-- This measures the cost of creating the RouteProvider contract.

runCreateRouteProvider : (Text, Text) -> Script ()
runCreateRouteProvider (providerText, suffix) = script do
  provider <- parseParty providerText
  params <- lookupParams provider suffix

  routeProviderCid <- toInterfaceContractId @RouteProvider.I <$> submit provider do
    createCmd SingleCustodian with
      provider = provider
      observers = fromList [params.alice, params.bob]
      custodian = params.custodian

  submit provider do
    createCmd RouteProviderState with
      provider
      suffix
      routeProviderCid

  pure ()
--------------------------------------------------------------------------------
-- Measured: DISCOVER N routes (1 tx)
-- Args: (provider, suffix, stepCount, amount)
-- Measures the cost of calling RouteProvider.Discover (single controller/provider only).

runDiscoverRoutes_N : (Text, Text, Text, Text) -> Script ()
runDiscoverRoutes_N (providerText, suffix, stepCountText, amountText) = script do
  provider <- parseParty providerText
  n <- parseNat stepCountText
  amount <- parseDecimalOrAbort amountText

  params <- lookupParams provider suffix
  rp <- lookupRouteProvider provider suffix

  let steps = replicate n (mkStep params.alice params.bob params.unit amount)

  (_routedSteps : [ST.RoutedStep]) <- submit provider do
    exerciseCmd rp.routeProviderCid RouteProvider.Discover with
      discoverors = fromList [provider]
      contextId = None
      steps = steps

  pure ()
