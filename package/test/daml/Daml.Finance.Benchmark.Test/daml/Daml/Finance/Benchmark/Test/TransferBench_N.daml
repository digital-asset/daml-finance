module Daml.Finance.Benchmark.Test.TransferBench_N where

import Daml.Script
import DA.Map qualified as Map (fromList)
import DA.Set qualified as Set (fromList)
import DA.Text qualified as Text (trim, parseDecimal)

import Daml.Finance.Interface.Types.Common.V3.Types
  ( AccountKey(..)
  , HoldingFactoryKey(..)
  , HoldingStandard(..)
  , Id(..)
  , InstrumentKey(..)
  , PartiesMap(..)
  )

-- Interface deps
import Daml.Finance.Interface.Account.V4.Factory qualified as AccountFactory (I)
import Daml.Finance.Interface.Holding.V4.Factory qualified as HoldingFactory (I, Reference(..), View(..))
import Splice.Api.Token.HoldingV1 qualified as Api.HoldingV1 (Holding)
import Daml.Finance.Interface.Instrument.Token.V4.Factory qualified as TokenFactory (Create(..), I)
import Daml.Finance.Interface.Instrument.Token.V4.Types (Token(..))

-- Impl deps (to create factories)
import Daml.Finance.Account.V4.Account qualified as Account (Factory(..))
import Daml.Finance.Holding.V4.Factory qualified as Holding (Factory(..))
import Daml.Finance.Instrument.Token.V4.Factory qualified as Token (Factory(..))

-- Workflows
import Daml.Finance.Benchmark.Test.Workflow.CreateAccount qualified as CreateAccount (Accept(..), Request(..))
import Daml.Finance.Benchmark.Test.Workflow.CreditAccount qualified as CreditAccount (Accept(..), Request(..))
import Daml.Finance.Benchmark.Test.Workflow.Transfer qualified as Transfer (Accept(..), Request(..))  -- this is your tutorial workflow

--------------------------------------------------------------------------------
-- Transfer request 

template TransferBenchSetup
  with
    bank : Party
    alice : Party
    bob : Party
    suffix : Text

    accountFactoryCid : ContractId AccountFactory.I
    holdingFactoryKey : HoldingFactoryKey
    tokenFactoryCid   : ContractId TokenFactory.I

    aliceAccount : AccountKey
    bobAccount   : AccountKey
    cashInstrument : InstrumentKey

    aliceCashHoldingCid : ContractId Api.HoldingV1.Holding
  where
    signatory bank
    observer alice, bob

    key (bank, suffix) : (Party, Text)
    maintainer key._1

--------------------------------------------------------------------------------
-- Helpers
debugCommon : Party -> Party -> Party -> Text -> Text -> Script ()
debugCommon alice bank bob suffix extra = do
  debug $ "ALICE_ID=" <> show alice
  debug $ "BANK_ID=" <> show bank
  debug $ "BOB_ID=" <> show bob
  debug $ "SUFFIX=" <> show suffix
  debug $ "EXTRA=" <> show extra

parseParty : Text -> Script Party
parseParty t =
  case partyFromText (Text.trim t) of
    Some p -> pure p
    None -> abort ("Bad party id: " <> t)

parseDecimalText : Text -> Script Decimal
parseDecimalText t =
  case Text.parseDecimal (Text.trim t) of
    Some d -> pure d
    None -> abort ("Bad decimal: " <> t)

lookupSetup : Party -> Text -> Script (ContractId TransferBenchSetup, TransferBenchSetup)
lookupSetup bank suffix = do
  m <- queryContractKey @TransferBenchSetup bank (bank, suffix)
  case m of
    None ->
      abort $
        "TransferBenchSetup not found for key (bank, suffix)=("
          <> show bank <> ", " <> show suffix <> "). Did you run runSetup?"
    Some (cid, st) -> pure (cid, st)

mkObservers : [Party] -> PartiesMap
mkObservers ps =
  if null ps then mempty
  else Map.fromList [("Observers", Set.fromList ps)]

--------------------------------------------------------------------------------
-- Setup (run once / not measured)
-- Args: (ALICE_ID, BANK_ID, BOB_ID, suffix)

runSetup : (Text, Text, Text, Text) -> Script ()
runSetup (aliceText, bankText, bobText, suffix) = script do
  alice <- parseParty aliceText
  bank  <- parseParty bankText
  bob   <- parseParty bobText

  debugCommon alice bank bob suffix "setup"

  -- Account Factory
  accountFactoryCid <- toInterfaceContractId @AccountFactory.I <$> submit bank do
    createCmd Account.Factory with
      provider = bank
      observers = mempty

  -- Holding Factory (+ Reference so key-lookup works where used)
  let holdingFactoryId = Id ("HoldingFactory@" <> suffix)

  holdingFactoryCid : ContractId HoldingFactory.I <-
    toInterfaceContractId @HoldingFactory.I <$> submit bank do
      createCmd Holding.Factory with
        provider = bank
        id = holdingFactoryId
        observers = mkObservers [alice, bob]

  submit bank do
    createCmd HoldingFactory.Reference with
      factoryView = HoldingFactory.View with
        provider = bank
        id = holdingFactoryId
      cid = holdingFactoryCid
      observers = mkObservers [alice, bob]

  let holdingFactoryKey = HoldingFactoryKey with
        provider = bank
        id = holdingFactoryId

  -- Token Factory
  tokenFactoryCid <- toInterfaceContractId @TokenFactory.I <$> submit bank do
    createCmd Token.Factory with
      provider = bank
      observers = mempty

  -- Create Alice account @ bank
  -- Same as in HoldingBench_M module --> Alice holds USD 100 in her account at the Bank
  aliceReqCid <- submit alice do
    createCmd CreateAccount.Request with
      owner = alice
      custodian = bank

  aliceAccount <- submit bank do
    exerciseCmd aliceReqCid CreateAccount.Accept with
      label = "Alice@Bank"
      description = "Account of Alice at Bank"
      accountFactoryCid
      holdingFactory = holdingFactoryKey
      observers = mempty
      controllers = None

  -- Create Bob account @ bank
  bobReqCid <- submit bob do
    createCmd CreateAccount.Request with
      owner = bob
      custodian = bank

  bobAccount <- submit bank do
    exerciseCmd bobReqCid CreateAccount.Accept with
      label = "Bob@Bank"
      description = "Account of Bob at Bank"
      accountFactoryCid
      holdingFactory = holdingFactoryKey
      observers = [alice]
      controllers = None

  -- Issue USD instrument (once)
  let
    instrumentKey = InstrumentKey with
      issuer = bank
      depository = bank
      id = Id "USD"
      version = "0"
      holdingStandard = TransferableFungible

  now <- getTime
  submit bank do
    exerciseCmd tokenFactoryCid TokenFactory.Create with
      token = Token with
        instrument = instrumentKey
        description = "Instrument representing units of a generic token"
        validAsOf = now
      observers = mempty
  
  -- Credit Alice with a cash holding (NO multi-submit)
  -- Tx 1: Alice creates a credit request
  aliceCreditReqCid <- submit alice do
    createCmd CreditAccount.Request with
      account = aliceAccount
      instrument = instrumentKey
      amount = 1000.0

  -- Tx 2: Bank accepts -> creates the holding, returns holding cid
  aliceCashHoldingCid <- submit bank do
    exerciseCmd aliceCreditReqCid CreditAccount.Accept

  -- Persist bench state
  submit bank do
    createCmd TransferBenchSetup with
      bank
      alice
      bob
      suffix
      accountFactoryCid
      holdingFactoryKey
      tokenFactoryCid
      aliceAccount
      bobAccount
      cashInstrument = instrumentKey
      aliceCashHoldingCid

  debug "Setup done"
  pure ()

--------------------------------------------------------------------------------
-- Measured: TRANSFER REQUEST (1 tx) + ACCEPT (1tx)
-- Args: (BANK_ID, suffix, amountText)

runTransferRequestAccept : (Text, Text, Text) -> Script ()
runTransferRequestAccept (bankText, suffix, amountText) = script do
  bank <- parseParty bankText
  (_, setup) <- lookupSetup bank suffix
  amount <- parseDecimalText amountText

  debugCommon setup.alice bank setup.bob suffix ("transfer-request amount=" <> show amount)

  transferRequestCid <- submit setup.bob do
    createCmd Transfer.Request with
      receiverAccount = setup.bobAccount
      instrument = setup.cashInstrument
      amount = amount
      currentOwner = setup.alice

  bobCashHoldingCid <- submit setup.alice do
    exerciseCmd transferRequestCid Transfer.Accept with 
      holdingCid = setup.aliceCashHoldingCid

  debug "Transfer.Request submitted by Bob + Transfer.Accept exercised by Alice (holding moved to Bob) "
  pure ()