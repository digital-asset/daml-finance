module Daml.Finance.Benchmark.Test.Elementary.Preload where

-- A minimal keyed contract so we can exercise by key in other benchmarks.
-- Why so minimal?
--     Because every extra field, observer, or interface would add noise to cost measurements.
template BenchKeyed
  with
    owner : Party   -- the single controlling party
    name  : Text    -- used only to make the contract uniquely identifiable via a key
  where
    signatory owner     

    key (owner, name) : (Party, Text)  
    maintainer key._1

    nonconsuming choice Ping : () with
      controller owner
      do pure ()


-- Non-consuming choice: Ping:
-- - This choice is intentionally trivial:
--     1) nonconsuming
--         no archive
--         no create
--         no contract lifecycle change
--     2) returns ()
--         no data
--     3) does nothing
--         pure ()

-- So what does it measure?
--     -->  Only the cost of executing a choice itself

