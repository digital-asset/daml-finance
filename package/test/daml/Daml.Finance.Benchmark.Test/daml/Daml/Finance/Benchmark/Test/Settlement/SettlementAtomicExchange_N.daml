module Daml.Finance.Benchmark.Test.Settlement.SettlementAtomicExchange_N where

import Daml.Script
import DA.Set qualified as Set
import DA.Map qualified as Map
import DA.Text qualified as Text

-- Common types
import Daml.Finance.Interface.Types.Common.V3.Types
  ( Id(..), AccountKey(..), InstrumentKey(..), HoldingFactoryKey(..), HoldingStandard(..), PartiesMap )

import Daml.Finance.Interface.Instrument.Token.V4.Factory qualified as TokenFactory (Create(..), I)
import Daml.Finance.Interface.Instrument.Token.V4.Types (Token(..))

import Daml.Finance.Interface.Account.V4.Factory qualified as AccountFactory (I)
import Daml.Finance.Interface.Holding.V4.Factory qualified as HoldingFactory (I, Reference(..), View(..))

import Daml.Finance.Account.V4.Account qualified as AccountImpl (Factory(..))
import Daml.Finance.Holding.V4.Factory qualified as HoldingImpl (Factory(..))
import Daml.Finance.Instrument.Token.V4.Factory qualified as TokenImpl (Factory(..))

import Daml.Finance.Benchmark.Test.Workflow.CreateAccount qualified as CreateAccount (Accept(..), Request(..))
import Daml.Finance.Benchmark.Test.Workflow.CreditAccount qualified as CreditAccount (Accept(..), Request(..))

-- Settlement interfaces
import Daml.Finance.Interface.Settlement.V4.RouteProvider qualified as RouteProvider (Discover(..), I)
import Daml.Finance.Interface.Settlement.V4.Factory qualified as SettlementFactory (Instruct(..), I)
import Daml.Finance.Interface.Settlement.V4.Batch qualified as Batch (Settle(..))
import Daml.Finance.Interface.Settlement.V4.Instruction qualified as Instruction (Allocate(..), Approve(..))
import Daml.Finance.Interface.Settlement.V4.Types qualified as ST (Step(..), Quantity(..), Allocation(..), Approval(..))
import Daml.Finance.Interface.Account.V4.Account qualified as Account (Controllers(..))

-- Single custodian route provider + settlement factory implementation
import Daml.Finance.Settlement.V4.RouteProvider.SingleCustodian (SingleCustodian(..))
import Daml.Finance.Settlement.V4.Factory qualified as Settlement (Factory(..))

-- Splice InstrumentId for ST.Quantity.unit
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Splice.Api.Token.HoldingV1 qualified as Api (Holding)

--------------------------------------------------------------------------------
-- Helpers

parseParty : Text -> Script Party
parseParty t =
  case partyFromText (Text.trim t) of
    Some p -> pure p
    None -> abort ("Bad party id: " <> show t)

parseDecimal : Text -> Script Decimal
parseDecimal t =
  case Text.parseDecimal (Text.trim t) of
    Some d -> pure d
    None -> abort ("Bad decimal: " <> show t)

mkObservers : [Party] -> PartiesMap
mkObservers ps =
  if null ps then mempty
  else Map.fromList [("Observers", Set.fromList ps)]

-- Convert an InstrumentKey to the Splice InstrumentId needed by settlement Step.Quantity.unit.
-- In many DAML Finance modules, the admin can be modeled as the depository or issuer.
-- Here we use the depository as the admin.
toInstrumentId : InstrumentKey -> InstrumentId
toInstrumentId ik =
  InstrumentId with
    admin = ik.depository
    id = show ik.id 

mkStep : Party -> Party -> InstrumentId -> Decimal -> ST.Step
mkStep sender receiver unit amount =
  ST.Step with
    sender = sender
    receiver = receiver
    quantity = ST.Quantity with
      amount = amount
      unit = unit

ownerControllers : Party -> Account.Controllers
ownerControllers p =
  Account.Controllers with
    outgoing = Set.singleton p
    incoming = Set.singleton p

--------------------------------------------------------------------------------
-- Stored immutable setup (run once)

template AtomicExchangeSetup
  with
    bank : Party
    alice : Party
    bob : Party
    suffix : Text

    -- Infra
    tokenFactoryCid : ContractId TokenFactory.I
    routeProviderCid : ContractId RouteProvider.I
    settlementFactoryCid : ContractId SettlementFactory.I

    -- Accounts
    aliceAccount : AccountKey
    bobAccount : AccountKey

    -- Instruments
    usdInstrument : InstrumentKey
    tokenInstrument : InstrumentKey

    -- Holdings (starting point)
    aliceTokenHoldingCid : ContractId Api.Holding
    bobCashHoldingCid : ContractId Api.Holding
  where
    signatory bank
    observer alice, bob
    key (bank, suffix) : (Party, Text)
    maintainer key._1

lookupSetup : Party -> Text -> Script (ContractId AtomicExchangeSetup, AtomicExchangeSetup)
lookupSetup bank suffix = do
  m <- queryContractKey @AtomicExchangeSetup bank (bank, suffix)
  case m of
    None -> abort ("AtomicExchangeSetup not found for suffix=" <> show suffix <> ". Run runSetup first.")
    Some x -> pure x

--------------------------------------------------------------------------------
-- Setup (run once / not measured)
-- Args: (BANK_ID, ALICE_ID, BOB_ID, suffix)
--
-- Creates:
-- - factories
-- - accounts for Alice/Bob at Bank
-- - USD + TOKEN instruments
-- - holdings: Bob has USD cash, Alice has TOKEN
-- - RouteProvider + SettlementFactory infra
-- - stores everything in AtomicExchangeSetup

runSetup : (Text, Text, Text, Text) -> Script ()
runSetup (bankText, aliceText, bobText, suffixText) = script do
  bank  <- parseParty bankText
  alice <- parseParty aliceText
  bob   <- parseParty bobText
  let suffix = Text.trim suffixText

  -- Holding factory
  let holdingFactoryId = Id ("holdingFactory-" <> suffix)
  holdingFactoryCid <- toInterfaceContractId @HoldingFactory.I <$> submit bank do
    createCmd HoldingImpl.Factory with
      provider = bank
      id = holdingFactoryId
      observers = mkObservers [alice, bob]

  submit bank do
    createCmd HoldingFactory.Reference with
      factoryView = HoldingFactory.View with provider = bank; id = holdingFactoryId
      cid = holdingFactoryCid
      observers = mkObservers [alice, bob]

  let holdingFactoryKey = HoldingFactoryKey with provider = bank; id = holdingFactoryId

  -- Account factory
  accountFactoryCid <- toInterfaceContractId @AccountFactory.I <$> submit bank do
    createCmd AccountImpl.Factory with
      provider = bank
      observers = mempty

  -- Token factory
  tokenFactoryCid <- toInterfaceContractId @TokenFactory.I <$> submit bank do
    createCmd TokenImpl.Factory with
      provider = bank
      observers = mempty

  -- Create Alice account @ bank
  aliceReqCid <- submit alice do
    createCmd CreateAccount.Request with owner = alice; custodian = bank

  aliceAccount <- submit bank do
    exerciseCmd aliceReqCid CreateAccount.Accept with
      label = "Alice@Bank-" <> suffix
      description = "Alice account at Bank (benchmark)"
      accountFactoryCid
      holdingFactory = holdingFactoryKey
      observers = mempty
      controllers = Some (ownerControllers alice)

  -- Create Bob account @ bank
  bobReqCid <- submit bob do
    createCmd CreateAccount.Request with owner = bob; custodian = bank

  bobAccount <- submit bank do
    exerciseCmd bobReqCid CreateAccount.Accept with
      label = "Bob@Bank-" <> suffix
      description = "Bob account at Bank (benchmark)"
      accountFactoryCid
      holdingFactory = holdingFactoryKey
      observers = mempty
      controllers = Some (ownerControllers bob)

  -- Instruments (USD + TOKEN)
  let usdInstrument = InstrumentKey with
        issuer = bank; depository = bank; id = Id ("USD-" <> suffix); version = "0"
        holdingStandard = TransferableFungible

  let tokenInstrument = InstrumentKey with
        issuer = bank; depository = bank; id = Id ("TOKEN-" <> suffix); version = "0"
        holdingStandard = TransferableFungible

  now <- getTime
  submit bank do
    exerciseCmd tokenFactoryCid TokenFactory.Create with
      token = Token with instrument = usdInstrument; description = "USD cash"; validAsOf = now
      observers = mempty

  submit bank do
    exerciseCmd tokenFactoryCid TokenFactory.Create with
      token = Token with instrument = tokenInstrument; description = "Generic token"; validAsOf = now
      observers = mempty

  -- Credit Bob with USD cash holding (Bob request, Bank accept)
  bobCashReqCid <- submit bob do
    createCmd CreditAccount.Request with
      account = bobAccount
      instrument = usdInstrument
      amount = 1000.0

  bobCashHoldingCid <- submit bank do
    exerciseCmd bobCashReqCid CreditAccount.Accept

  -- Credit Alice with TOKEN holding (Alice request, Bank accept)
  aliceTokReqCid <- submit alice do
    createCmd CreditAccount.Request with
      account = aliceAccount
      instrument = tokenInstrument
      amount = 10.0

  aliceTokenHoldingCid <- submit bank do
    exerciseCmd aliceTokReqCid CreditAccount.Accept

  -- RouteProvider (Single custodian)
  routeProviderCid <- toInterfaceContractId @RouteProvider.I <$> submit bank do
    createCmd SingleCustodian with
      provider = bank
      observers = Set.fromList [alice, bob]
      custodian = bank

  -- SettlementFactory
  settlementFactoryCid <- toInterfaceContractId @SettlementFactory.I <$> submit bank do
    createCmd Settlement.Factory with
      provider = bank
      observers = Set.fromList [alice, bob]

  -- Persist immutable setup
  submit bank do
    createCmd AtomicExchangeSetup with
      bank
      alice
      bob
      suffix
      tokenFactoryCid
      routeProviderCid
      settlementFactoryCid
      aliceAccount
      bobAccount
      usdInstrument
      tokenInstrument
      aliceTokenHoldingCid
      bobCashHoldingCid

  debug "AtomicExchange setup done"
  pure ()

--------------------------------------------------------------------------------
-- Measured: Full atomic exchange settlement (single flow)
-- Args: (BANK_ID, suffix, tokenAmt, cashAmt)
--
-- Does:
-- - Discover routes for 2 legs (Bob pays USD to Alice, Alice delivers TOKEN to Bob)
-- - Instruct batch + 2 instructions
-- - Allocate + approve both legs
-- - Settle batch
--
-- NOTE: This will be multiple submits (by design), because allocation/approval require different controllers.

runAtomicExchange : (Text, Text, Text, Text) -> Script ()
runAtomicExchange (bankText, suffixText, tokenAmtText, cashAmtText) = script do
  bank <- parseParty bankText
  let suffix = Text.trim suffixText
  tokenAmt <- parseDecimal tokenAmtText
  cashAmt<- parseDecimal cashAmtText

  (_, setup) <- lookupSetup bank suffix

  let usdUnit = toInstrumentId setup.usdInstrument
  let tokenUnit = toInstrumentId setup.tokenInstrument

  -- Two-legged exchange:
  -- 1) Bob pays USD to Alice
  -- 2) Alice delivers TOKEN to Bob
  let payStep = mkStep setup.bob setup.alice usdUnit cashAmt
  let recStep = mkStep setup.alice setup.bob tokenUnit tokenAmt
  let steps = [payStep, recStep]

  -- Bank: discover + instruct
  routedSteps <- submit setup.bank do
    exerciseCmd setup.routeProviderCid RouteProvider.Discover with
      discoverors = Set.singleton setup.bank
      contextId = None
      steps = steps

  (batchCid, instructionCids) <- submit setup.bank do
    exerciseCmd setup.settlementFactoryCid SettlementFactory.Instruct with
      instructor = setup.bank
      consenters = Set.singleton setup.bank
      settlers = Set.fromList [setup.alice, setup.bob, setup.bank]
      id = Id ("atomic-exchange-" <> suffix)
      description = "Atomic exchange via RouteProvider + SettlementFactory"
      contextId = None
      routedSteps = routedSteps
      settlementTime = None

  let [iPay, iRec] = instructionCids

  -- Allocate + approve:
  -- Pay leg: Bob pledges USD holding, Alice takes delivery
  (iPay2, _) <- submit setup.bob do
    exerciseCmd iPay Instruction.Allocate with
      actors = Set.singleton setup.bob
      allocation = ST.Pledge setup.bobCashHoldingCid

  _ <- submit setup.alice do
    exerciseCmd iPay2 Instruction.Approve with
      actors = Set.singleton setup.alice
      approval = ST.TakeDelivery setup.aliceAccount

  -- Receive leg: Alice pledges TOKEN holding, Bob takes delivery
  (iRec2, _) <- submit setup.alice do
    exerciseCmd iRec Instruction.Allocate with
      actors = Set.singleton setup.alice
      allocation = ST.Pledge setup.aliceTokenHoldingCid

  _ <- submit setup.bob do
    exerciseCmd iRec2 Instruction.Approve with
      actors = Set.singleton setup.bob
      approval = ST.TakeDelivery setup.bobAccount

  -- Settle (any settler works; use Bank or Bob; here: Bank)
  _newHoldings <- submit setup.bob do
    exerciseCmd batchCid Batch.Settle with
      actors = Set.singleton setup.bob

  pure ()
