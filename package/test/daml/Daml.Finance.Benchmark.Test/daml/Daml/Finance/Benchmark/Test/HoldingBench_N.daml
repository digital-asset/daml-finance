module Daml.Finance.Benchmark.Test.HoldingBench_N where

import Daml.Script

import DA.Map qualified as Map (fromList)
import DA.Set qualified as Set (fromList)
import DA.Text qualified as Text (trim, splitOn)

import Daml.Finance.Interface.Types.Common.V3.Types
  ( AccountKey(..)
  , Id(..)
  , InstrumentKey(..)
  , PartiesMap
  )
import Daml.Finance.Interface.Types.Common.V3.Types qualified as HS (HoldingStandard(..))

import Daml.Finance.Holding.V4.BaseHolding qualified as BaseHolding

--------------------------------------------------------------------------------
-- Bench state (so “mint” can be isolated in a later run)

template HoldingBenchState
  with
    bank : Party
    alice : Party
    aliceAccount : AccountKey
    instrument : InstrumentKey
    suffix : Text
  where
    signatory bank
    observer alice
    key (bank, suffix) : (Party, Text)
    maintainer key._1

--------------------------------------------------------------------------------
-- Helpers

debugCommon : Party -> Party -> Text -> Text -> Script ()
debugCommon alice bank observersText suffix = do
  debug $ "ALICE_ID=" <> show alice
  debug $ "BANK_ID=" <> show bank
  debug $ "OBSERVERS_TEXT=" <> show observersText
  debug $ "SUFFIX=" <> show suffix

parseParty : Text -> Script Party
parseParty t =
  case partyFromText t of
    Some p -> pure p
    None -> abort ("Bad party id: " <> t)

-- Parse "p1;p2;..." => [Party]. Empty/blank => [].
parseParties : Text -> Script [Party]
parseParties observersText = do
  let
    trimmed = Text.trim observersText
    parts =
      if trimmed == ""
      then []
      else map Text.trim (Text.splitOn ";" trimmed)
    nonEmpty = filter (\t -> Text.trim t /= "") parts
  mapA parseParty nonEmpty

mkObserversMap : [Party] -> PartiesMap
mkObserversMap ps =
  if null ps
    then mempty
    else Map.fromList [("Observers", Set.fromList ps)]

-- Lookup state by key (bank, suffix)
lookupState : Party -> Text -> Script (ContractId HoldingBenchState, HoldingBenchState)
lookupState bank suffix = do
  m <- queryContractKey @HoldingBenchState bank (bank, suffix)
  case m of
    None ->
      abort $
        "HoldingBenchState not found for key (bank, suffix)=("
          <> show bank <> ", " <> show suffix <> "). Did you run runSetup?"
    Some (cid, st) -> pure (cid, st)

--------------------------------------------------------------------------------
-- 1) Setup: store AccountKey + InstrumentKey under (bank, suffix)

-- Args: (ALICE_ID, BANK_ID, "obs1;obs2;...", suffix)
runSetup : (Text, Text, Text, Text) -> Script ()
runSetup (aliceText, bankText, observersText, suffix) = script do
  alice <- parseParty aliceText
  bank  <- parseParty bankText
  _obs  <- parseParties observersText  -- not used in setup; kept for symmetry/logging

  debugCommon alice bank observersText suffix

  let
    aliceAccount : AccountKey
    aliceAccount = AccountKey with
      owner = alice
      custodian = bank
      id = Id ("Alice@" <> suffix)

  let
    instrumentKey : InstrumentKey
    instrumentKey = InstrumentKey with
      issuer = bank
      depository = bank
      id = Id "USD"
      version = "0"
      holdingStandard = HS.BaseHolding

  _stCid <- submit bank do
    createCmd HoldingBenchState with
      bank
      alice
      aliceAccount
      instrument = instrumentKey
      suffix

  debug "HoldingBench setup done"
  pure ()

--------------------------------------------------------------------------------
-- 2) Mint-only: create exactly 1 BaseHolding in ONE transaction

-- Args: (BANK_ID, "obs1;obs2;...", suffix)
runMint : (Text, Text, Text) -> Script ()
runMint (bankText, observersText, suffix) = script do
  bank <- parseParty bankText
  observers <- parseParties observersText

  (_stCid, st) <- lookupState bank suffix

  let
    alice = st.alice
    aliceAccount = st.aliceAccount
    instrumentKey = st.instrument
    obsMap = mkObserversMap observers

  debugCommon alice bank observersText suffix

  _hCid <- submit [bank, alice] do
    createCmd BaseHolding.BaseHolding with
      instrument = instrumentKey
      account = aliceAccount
      amount = 1000.0
      lock = None
      observers = obsMap

  debug "Mint (BaseHolding) done"
  pure ()
