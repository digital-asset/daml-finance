module Daml.Finance.Benchmark.Test.ExerciseByKey_N where

import Daml.Script
import Daml.Finance.Benchmark.Test.Preload_N 

parseParty : Text -> Script Party
parseParty t =
  case partyFromText t of
    Some p -> pure p
    None -> abort ("Bad party id: " <> t)

--------------------------------------------------------------------------------
-- Variant 1: BenchKeyed_OwnerCtrl
-- Controller: owner
-- Input: OWNER_ID

runOwnerCtrl : Text -> Script ()
runOwnerCtrl ownerText = script do
  debug ("runOwnerCtrl owner=" <> ownerText)
  owner <- parseParty ownerText
  submit owner do
    exerciseByKeyCmd @BenchKeyed_OwnerCtrl (owner, "bench") Ping_OwnerCtrl
  pure ()

--------------------------------------------------------------------------------
-- Variant 2: BenchKeyed_TwoSignatories
-- Signatories: owner + cp
-- Controller: owner
-- Input: OWNER_ID

runTwoSignatories : Text -> Script ()
runTwoSignatories ownerText = script do
  owner <- parseParty ownerText
  debug ("runTwoSignatories owner=" <> ownerText)
  submit owner do
    exerciseByKeyCmd @BenchKeyed_TwoSignatories (owner, "bench") Ping_TwoSignatories
  pure ()

--------------------------------------------------------------------------------
-- Variant 3: BenchKeyed_CpControls
-- Controller: cp
-- Input: OWNER_ID, CP_ID
-- controller is cp, so submit as cp.

runCpControls : (Text, Text) -> Script ()
runCpControls (ownerText, cpText) = script do
  debug ("runCpControls owner=" <> ownerText <> " cp=" <> cpText)
  owner <- parseParty ownerText
  cp <- parseParty cpText
  submit cp do
    exerciseByKeyCmd @BenchKeyed_CpControls (owner, "bench") Ping_CpControls
  pure ()

--------------------------------------------------------------------------------
-- Variant 4: BenchKeyed_JointCtrl
-- Controller: owner + cp
-- Input: OWNER_ID, CP_ID

runJointCtrl : (Text, Text) -> Script ()
runJointCtrl (ownerText, cpText) = script do
  debug ("runJointCtrl owner=" <> ownerText <> " cp=" <> cpText)
  owner <- parseParty ownerText
  cp <- parseParty cpText
  submit [owner, cp] do
    exerciseByKeyCmd @BenchKeyed_JointCtrl (owner, "bench") Ping_JointCtrl
  pure ()

--------------------------------------------------------------------------------
-- Variant 5: BenchKeyed_ThreeSignatories
-- Signatories: owner + cp + cp2
-- Controller: owner  
-- Input: OWNER_ID

runThreeSignatories : Text -> Script ()
runThreeSignatories ownerText = script do
  debug ("runThreeSignatories owner=" <> ownerText)
  owner <- parseParty ownerText
  submit owner do
    exerciseByKeyCmd @BenchKeyed_ThreeSignatories (owner, "bench") Ping_ThreeSignatories
  pure ()