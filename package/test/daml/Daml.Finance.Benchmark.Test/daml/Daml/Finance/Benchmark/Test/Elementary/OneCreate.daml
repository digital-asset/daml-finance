module Daml.Finance.Benchmark.Test.Elementary.OneCreate where

import Daml.Script
import Daml.Finance.Benchmark.Test.Elementary.Preload

-- Exactly 1 create per run. One argument: (ownerText, i)
run : (Text, Text) -> Script ()
run (ownerText, suffix) = script do
  let owner =
        case partyFromText ownerText of
          Some p -> p
          None -> error ("Bad OWNER_ID: " <> ownerText)

  submit owner do
    createCmd BenchKeyed with
      owner = owner
      name  = "create-" <> suffix

  pure ()