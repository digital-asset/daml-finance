--------------------------------------------------------------------------------
-- Variant 5: BenchKeyed_ThreeSignatories
-- Fields: owner, cp, cp2, observers, name
-- Input: (OWNER_ID, CP_ID, CP2_ID, "obs1;obs2;obs3")
-- IMPORTANT:
--   signatory owner, cp, cp2  => must submit [owner, cp, cp2] for create

runThreeSignatories : (Text, Text, Text, Text) -> Script (ContractId BenchKeyed_ThreeSignatories)
runThreeSignatories (ownerText, cpText, cp2Text, observersText) = script do
  owner <- parseParty ownerText
  cp <- parseParty cpText
  cp2 <- parseParty cp2Text
  observers <- parseObservers observersText
  debugCommon owner observersText
  debug ("CP_ID=" <> partyToText cp)
  debug ("CP2_ID=" <> partyToText cp2)
  cid <- submit [owner, cp, cp2] do
    createCmd BenchKeyed_ThreeSignatories with
      owner
      cp
      cp2
      observers
      name = "bench"
  debug ("CID=" <> show cid)
  pure cid

