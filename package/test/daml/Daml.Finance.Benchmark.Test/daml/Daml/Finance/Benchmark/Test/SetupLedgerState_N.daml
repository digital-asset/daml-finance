module Daml.Finance.Benchmark.Test.SetupLedgerState_N where

import Daml.Script
import DA.Text (splitOn)

import Daml.Finance.Benchmark.Test.Preload_N
  ( BenchKeyed_OwnerCtrl(..)
  , BenchKeyed_TwoSignatories(..)
  , BenchKeyed_CpControls(..)
  , BenchKeyed_JointCtrl(..)
  , BenchKeyed_ThreeSignatories(..)
  )

parseParty : Text -> Script Party
parseParty t =
  case partyFromText t of
    Some p -> pure p
    None -> abort ("Bad party id: " <> t)

parseObservers : Text -> Script [Party]
parseObservers observersText = do
  let raw = if observersText == "" then [] else splitOn ";" observersText
  let cleaned = filter (/= "") raw
  mapA parseParty cleaned

debugCommon : Party -> Text -> Script ()
debugCommon owner observersText = do
  debug ("OWNER_ID=" <> partyToText owner)
  debug ("OBSERVERS_TEXT=" <> observersText)

--------------------------------------------------------------------------------
-- Variant 1: BenchKeyed_OwnerCtrl
-- Fields: owner, observers, name
-- Input: (OWNER_ID, "obs1;obs2;obs3")

runOwnerCtrl : (Text, Text) -> Script (ContractId BenchKeyed_OwnerCtrl)
runOwnerCtrl (ownerText, observersText) = script do
  owner <- parseParty ownerText
  observers <- parseObservers observersText
  debugCommon owner observersText
  cid <- submit owner do
    createCmd BenchKeyed_OwnerCtrl with
      owner
      observers
      name = "bench"
  debug ("CID=" <> show cid)
  pure cid

--------------------------------------------------------------------------------
-- Variant 2: BenchKeyed_TwoSignatories
-- Fields: owner, cp, observers, name
-- Input: (OWNER_ID, CP_ID, "obs1;obs2;obs3")

runTwoSignatories : (Text, Text, Text) -> Script (ContractId BenchKeyed_TwoSignatories)
runTwoSignatories (ownerText, cpText, observersText) = script do
  owner <- parseParty ownerText
  cp <- parseParty cpText
  observers <- parseObservers observersText
  debugCommon owner observersText
  debug ("CP_ID=" <> partyToText cp)
  cid <- submit [owner, cp] do
    createCmd BenchKeyed_TwoSignatories with
      owner
      cp
      observers
      name = "bench"
  debug ("CID=" <> show cid)
  pure cid

--------------------------------------------------------------------------------
