-- Input: (OWNER_ID, CP_ID, "obs1;obs2;obs3")

runCpControls : (Text, Text, Text) -> Script (ContractId BenchKeyed_CpControls)
runCpControls (ownerText, cpText, observersText) = script do
  owner <- parseParty ownerText
  cp <- parseParty cpText
  observers <- parseObservers observersText
  debugCommon owner observersText
  debug ("CP_ID=" <> partyToText cp)
  cid <- submit owner do
    createCmd BenchKeyed_CpControls with
      owner
      cp
      observers
      name = "bench"
