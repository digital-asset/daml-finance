module Daml.Finance.Benchmark.Test.ExerciseByKey where

import Daml.Script
import Daml.Finance.Benchmark.Test.Preload 

-- Benchmark: exactly 1 exercise of Ping, by key.
-- Assumes Setup created the BenchKeyed contract under key (owner, "bench").
run : Text -> Script ()
run ownerText = script do
  let owner =
        case partyFromText ownerText of
          Some p -> p
          None -> error ("Bad OWNER_ID: " <> ownerText)

  submit owner do
    exerciseByKeyCmd @BenchKeyed (owner, "bench") Ping

  pure ()