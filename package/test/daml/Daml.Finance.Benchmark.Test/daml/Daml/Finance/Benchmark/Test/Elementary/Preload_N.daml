module Daml.Finance.Benchmark.Test.Elementary.Preload_N where

-- Variant 1: owner controls, same as baseline but separate name if you want explicit selection
template BenchKeyed_OwnerCtrl
  with
    owner : Party
    observers : [Party]
    name : Text
  where
    signatory owner
    observer observers

    key (owner, name) : (Party, Text)
    maintainer key._1

    nonconsuming choice Ping_OwnerCtrl : () with
      controller owner
      do pure ()

-- Variant 2: two signatories (owner + cp), owner controls 
-- IMPORTANT: cannot create BenchKeyed_TwoSignatories via DAML Script unless you can multi-submit.
template BenchKeyed_TwoSignatories
  with
    owner : Party
    cp : Party
    observers : [Party]
    name : Text
  where
    signatory owner, cp
    observer observers

    key (owner, name) : (Party, Text)
    maintainer key._1

    nonconsuming choice Ping_TwoSignatories : () with
      controller owner
      do pure ()

-- Variant 3: counterparty controls (owner signatory), cp is also an observer so it sees it
template BenchKeyed_CpControls
  with
    owner : Party
    cp : Party
    observers : [Party]
    name : Text
  where
    signatory owner
    observer cp :: observers

    key (owner, name) : (Party, Text)
    maintainer key._1

    nonconsuming choice Ping_CpControls : () with
      controller cp
      do pure ()

-- Variant 4: joint controller (owner + cp), cp is also an observer
template BenchKeyed_JointCtrl
  with
    owner : Party
    cp : Party
    observers : [Party]
    name : Text
  where
    signatory owner
    observer cp :: observers

    key (owner, name) : (Party, Text)
    maintainer key._1

    nonconsuming choice Ping_JointCtrl : () with
      controller owner, cp
      do pure ()

-- Variant 5: three signatories (owner + cp + cp2), owner controls
template BenchKeyed_ThreeSignatories
  with
    owner : Party
    cp : Party
    cp2 : Party
    observers : [Party]
    name : Text
  where
    signatory owner, cp, cp2
    observer observers

    key (owner, name) : (Party, Text)
    maintainer key._1

    nonconsuming choice Ping_ThreeSignatories : () with
      controller owner
      do pure ()

-- Variant 6: create multiple views
template BenchKeyed_View
  with
    owner : Party
    obs   : Party
    name  : Text
  where
    signatory owner
    observer obs

    key (owner, name) : (Party, Text)
    maintainer key._1

    nonconsuming choice Ping_View : ()
      controller owner
      do pure ()