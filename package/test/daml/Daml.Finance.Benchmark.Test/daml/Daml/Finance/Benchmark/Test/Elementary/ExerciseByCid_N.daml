module Daml.Finance.Benchmark.Test.Elementary.ExerciseByCid_N where

import Daml.Script
import Daml.Finance.Benchmark.Test.Elementary.Preload_N

parseParty : Text -> Script Party
parseParty t =
  case partyFromText t of
    Some p -> pure p
    None -> abort ("Bad party id: " <> t)

--------------------------------------------------------------------------------
-- Variant 1: BenchKeyed_OwnerCtrl
-- Controller: owner
-- Input: (OWNER_ID, CID)

runOwnerCtrl : (Text, ContractId BenchKeyed_OwnerCtrl) -> Script ()
runOwnerCtrl (ownerText, cid) = script do
  owner <- parseParty ownerText
  submit owner do
    exerciseCmd cid Ping_OwnerCtrl
  pure ()

--------------------------------------------------------------------------------
-- Variant 2: BenchKeyed_TwoSignatories
-- Signatories: owner + cp
-- Controller: owner
-- Input: (OWNER_ID, CID)

runTwoSignatories : (Text, ContractId BenchKeyed_TwoSignatories) -> Script ()
runTwoSignatories (ownerText, cid) = script do
  owner <- parseParty ownerText
  submit owner do
    exerciseCmd cid Ping_TwoSignatories
  pure ()

--------------------------------------------------------------------------------
-- Variant 3: BenchKeyed_CpControls
-- Controller: cp
-- Input: (CP_ID, CID)
-- controller is cp, NOT owner

runCpControls : (Text, ContractId BenchKeyed_CpControls) -> Script ()
runCpControls (cpText, cid) = script do
  cp <- parseParty cpText
  submit cp do
    exerciseCmd cid Ping_CpControls
  pure ()

--------------------------------------------------------------------------------
-- Variant 4: BenchKeyed_JointCtrl
-- Controller: owner + cp
-- Input: (OWNER_ID, CP_ID, CID)

runJointCtrl : (Text, Text, ContractId BenchKeyed_JointCtrl) -> Script ()
runJointCtrl (ownerText, cpText, cid) = script do
  owner <- parseParty ownerText
  cp <- parseParty cpText
  submit [owner, cp] do
    exerciseCmd cid Ping_JointCtrl
  pure ()

--------------------------------------------------------------------------------
-- Variant 5: BenchKeyed_ThreeSignatories
-- Signatories: owner + cp + cp2
-- Controller: owner
-- Input: (OWNER_ID, CID)

runThreeSignatories : (Text, ContractId BenchKeyed_ThreeSignatories) -> Script ()
runThreeSignatories (ownerText, cid) = script do
  owner <- parseParty ownerText
  submit owner do
    exerciseCmd cid Ping_ThreeSignatories
  pure ()