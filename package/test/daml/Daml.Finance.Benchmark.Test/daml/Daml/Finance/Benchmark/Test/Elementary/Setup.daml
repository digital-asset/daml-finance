module Daml.Finance.Benchmark.Test.Elementary.Setup where

import Daml.Script
import Daml.Finance.Benchmark.Test.Elementary.Preload 

-- One-time setup:
--  - allocate bench-owner
--  - create one BenchKeyed contract under a stable key
run : Script ()
run = script do
  owner <- allocatePartyByHint (PartyIdHint "bench-owner")

   -- Print the *real* (namespaced) party id so bash can capture it.
  debug ("OWNER_ID=" <> partyToText owner)

  submit owner do
    createCmd BenchKeyed with
        owner
        name = "bench"
  pure ()


