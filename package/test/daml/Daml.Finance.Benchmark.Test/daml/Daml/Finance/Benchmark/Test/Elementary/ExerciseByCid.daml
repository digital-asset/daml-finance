module Daml.Finance.Benchmark.Test.Elementary.ExerciseByCid where

import Daml.Script
import Daml.Finance.Benchmark.Test.Elementary.Preload 

-- Benchmark: query to fetch CID + exercise 1 choice.
-- Useful to compare with ExerciseByKey (query overhead).
run : Text -> Script ()
run ownerText = script do
  let owner =
        case partyFromText ownerText of
          Some p -> p
          None -> error ("Bad OWNER_ID: " <> ownerText)

  Some (cid, _) <- queryContractKey @BenchKeyed owner (owner, "bench")
  submit owner do
    exerciseCmd cid Ping
  pure ()
