module Daml.Finance.Settlement.V4.Conversion where

import Daml.Finance.Interface.Types.Common.V3.Types (InstrumentKey(..), Id(..), HoldingStandard(..))
import Splice.Api.Token.HoldingV1 (InstrumentId(..))

toInstrumentKeyWithStandard : HoldingStandard -> InstrumentId -> InstrumentKey
toInstrumentKeyWithStandard standard (InstrumentId with admin = instrumentAdmin; id) =
  InstrumentKey
    with
      issuer = instrumentAdmin
      depository = instrumentAdmin
      id = Id id
      version = ""
      holdingStandard = standard

-- | Convert a Splice InstrumentId to a legacy InstrumentKey .
--   For callers taht do not pass Holding yet.
toInstrumentKey : Party -> InstrumentId -> InstrumentKey
toInstrumentKey admin (InstrumentId with admin = instrumentAdmin; id) =
  InstrumentKey
    with
      issuer = instrumentAdmin
      depository = instrumentAdmin
      id = Id id
      -- The version field is temporarily fixed to "0" as a neutral placeholder.
      -- This ensures backward compatibility during the transition to InstrumentId.
      version = ""
      holdingStandard = Fungible

-- | Convert a legacy InstrumentKey to a Splice InstrumentId.
fromInstrumentKey : InstrumentKey -> InstrumentId
fromInstrumentKey (InstrumentKey with issuer; id; ..) =
  InstrumentId with
    admin = issuer
    id = show id