module Daml.Finance.Interface.Util.V3.HoldingSplice where

import Splice.Api.Token.HoldingV1 qualified as SpliceHolding
import Daml.Finance.Interface.Types.Common.V3.Types (InstrumentKey(..), Id(..), HoldingStandard(..), Parties)
import Daml.Finance.Interface.Util.V3.Disclosure qualified as Disclosure (AddObservers(..), I, RemoveObservers(..))

-- Extract instrument metadata from a Splice Holding.
getInstrument : (HasToInterface t SpliceHolding.Holding) => Party -> t -> InstrumentKey
getInstrument issuerParty holding =
  let instrId = (view $ toInterface @SpliceHolding.Holding holding).instrumentId
  in InstrumentKey with
      issuer = issuerParty
      depository = instrId.admin
      id = Id instrId.id
      version = "0"
      holdingStandard = TransferableFungible

-- Extract the current token amount.
getAmount : (HasToInterface t SpliceHolding.Holding) => t -> Decimal
getAmount holding = (view $ toInterface @SpliceHolding.Holding holding).amount

-- Disclosure helpers (reuse existing logic).
disclose :
  ( HasInterfaceTypeRep i
  , HasToInterface i Disclosure.I
  , HasFromInterface i Disclosure.I
  )
  => (Text, Parties) -> Parties -> ContractId i -> Update (ContractId i)
disclose observersToAdd disclosers cid = fromInterfaceContractId <$>
  exercise (toInterfaceContractId @Disclosure.I cid) Disclosure.AddObservers with
    disclosers; observersToAdd

undisclose :
  ( HasInterfaceTypeRep i
  , HasToInterface i Disclosure.I
  , HasFromInterface i Disclosure.I
  )
  => (Text, Parties) -> Parties -> ContractId i -> Update (Optional (ContractId i))
undisclose observersToRemove disclosers cid = fmap fromInterfaceContractId <$>
  exercise (toInterfaceContractId @Disclosure.I cid) Disclosure.RemoveObservers with
    disclosers; observersToRemove
