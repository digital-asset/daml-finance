module Daml.Finance.NUCK where

import Daml.Script

template Nuck
  with
    p : Party
    id : Text
  where
    signatory p
    key (p, id) : (Party, Text)
    maintainer key._1

testNuck : Script ()
testNuck = script do
  alice <- allocatePartyByHint (PartyIdHint "AliceNUCK")

  -- Create first contract
  c1 <- submit alice do
    createCmd Nuck with
      p = alice
      id = "x"
  
  -- Create second contract with same key (allowed under NUCK)
  c2 <- submit alice do
    createCmd Nuck with
      p = alice
      id = "x"

  -- -- Attempt to create duplicate (should fail for unique key)
  -- submitMustFail alice do
  --   createCmd Nuck with
  --     p = alice
  --     id = "x"

  debug "Created two contracts with same key successfully (NUCK behavior)"
  -- Query the contract by key
  mb <- queryContractKey @Nuck alice (alice, "x")
  debug $ "queryContractKey returned: " <> show mb

  -- List all active contracts
  active <- query @Nuck alice
  debug $ "Active contracts: " <> show active

  pure ()
